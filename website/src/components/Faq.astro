---
import { Icon } from 'astro-icon/components';

const faqs = [
  {
    q: 'What does CertUI check for each endpoint?',
    a: 'It connects to every endpoint you configure and shows the leaf certificate expiry, the full certificate chain, the negotiated TLS version and cipher suite, supported TLS protocols and HTTP versions, DNS resolution and the domain WHOIS record.',
  },
  {
    q: 'How do I add the endpoints to track?',
    a: 'List them in a YAML file (config/config.yml by default, or point CERTUI_CONFIG_PATH at a file or directory of files), or set the ENDPOINTS environment variable to a comma-separated list of URLs — no config file needed.',
  },
  {
    q: 'When is a certificate flagged as expiring?',
    a: 'Each endpoint shows the days remaining on its certificate. Inside 30 days it turns to a warning, and once the leaf certificate lapses it is flagged as Expired.',
  },
  {
    q: 'Does it work with self-signed or internal certificates?',
    a: 'Yes. CertUI inspects certificates without enforcing trust, so internal services, homelab endpoints and self-signed certificates are shown just like public ones.',
  },
  {
    q: 'Does CertUI send alerts when a certificate is about to expire?',
    a: 'No — it is deliberately a status page, not a monitor. There is no alerting, metrics endpoint or history; it shows the state of your SSL/TLS certificates right now.',
  },
  {
    q: 'How often are certificates re-checked?',
    a: 'Results are cached for an hour. Use the refresh button in the dashboard to re-probe every endpoint immediately.',
  },
  {
    q: 'Is CertUI free?',
    a: 'Yes. CertUI is free and open source under the MIT License, and ships as a tiny Docker image for amd64 and arm64.',
  },
];
---

<section id="faq" class="scroll-mt-20 border-t border-border/70 bg-surface-2/50">
  <div class="mx-auto max-w-3xl px-5 py-16 sm:py-20">
    <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked questions</h2>

    <div class="mt-12 space-y-3">
      {
        faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-card px-5 py-4 transition open:border-accent/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <h3>{f.q}</h3>
              <Icon
                name="heroicons:chevron-down-20-solid"
                width="20"
                height="20"
                aria-hidden="true"
                class="shrink-0 text-faint transition group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
