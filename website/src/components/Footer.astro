---
import { REPO_URL, RELEASES_URL, LICENSE_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-surface-2">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 sm:flex-row">
    <div class="flex flex-col items-center gap-1.5 sm:items-start">
      <div class="flex items-center gap-2.5">
        <svg viewBox="0 0 64 64" class="h-5 w-5 text-accent" aria-hidden="true">
          <circle cx="32" cy="24" r="12" fill="none" stroke="currentColor" stroke-width="4"></circle>
          <path d="M26 36 L24 52 L32 46 L40 52 L38 36 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"></path>
          <path d="M26 24 L30 28 L38 20" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="text-sm font-semibold">CertUI</span>
        <span class="hidden text-sm text-faint sm:inline">· A status page for your TLS certificates</span>
      </div>
    </div>

    <div class="flex items-center gap-5 text-sm text-muted">
      <a href={REPO_URL} target="_blank" rel="noopener" class="transition hover:text-ink">GitHub</a>
      <a href={RELEASES_URL} target="_blank" rel="noopener" class="transition hover:text-ink">Releases</a>
      <a href={LICENSE_URL} target="_blank" rel="noopener" class="transition hover:text-ink">License</a>
    </div>
  </div>

  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-5 py-4 text-xs text-faint sm:flex-row">
      <span>© {year} Ben Burwood</span>
      <span>Built with Go + Vue</span>
    </div>
  </div>
</footer>
