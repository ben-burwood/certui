---
import { Icon } from 'astro-icon/components';

const features = [
  {
    icon: 'heroicons:shield-check',
    title: 'Expiry at a glance',
    body: 'Every configured endpoint gets a clear status badge — days remaining when healthy, a warning inside 30 days, and a red Expired flag once the leaf certificate lapses.',
  },
  {
    icon: 'heroicons:link',
    title: 'Full certificate chain',
    body: 'Expand any endpoint to walk the whole chain — subject, issuer, validity window, signature and public-key algorithm for the leaf and every intermediate.',
  },
  {
    icon: 'heroicons:lock-closed',
    title: 'TLS handshake details',
    body: 'See the negotiated TLS version, cipher suite, whether the handshake completed and whether the session resumed — straight from the live connection.',
  },
  {
    icon: 'heroicons:globe-alt',
    title: 'Domain resolution',
    body: 'Confirms each domain resolves and shows the address it points to, so a DNS or routing problem is obvious before you go hunting for it.',
  },
  {
    icon: 'heroicons:identification',
    title: 'WHOIS lookup',
    body: 'Surfaces the registrar, name servers and domain expiration date — because a domain lapsing is just as bad as a certificate lapsing.',
  },
];

const scope = [
  'No alerting — it is a status page, not a monitor',
  'No external metrics — no API or Prometheus scraping',
  'No history — it shows the certificates as they are right now',
];
---

<section id="features" class="scroll-mt-20 border-t border-border/70 bg-surface-2/50">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Everything you need to watch your certificates</h2>
      <p class="mt-4 text-lg text-muted">
        Purpose-built to do one job well: show the state of your TLS certificates, simply.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-xl border border-border bg-card p-5 transition hover:border-accent/40">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent ring-1 ring-accent/20">
              <Icon name={f.icon} width="20" height="20" aria-hidden="true" />
            </div>
            <h3 class="mt-4 font-semibold text-ink">{f.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>

    <!-- Deliberately minimal -->
    <div class="mx-auto mt-6 max-w-4xl rounded-xl border border-border bg-card p-5">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent ring-1 ring-accent/20">
          <Icon name="heroicons:scissors" width="18" height="18" aria-hidden="true" />
        </div>
        <div>
          <h3 class="font-semibold text-ink">Deliberately minimal</h3>
          <p class="mt-1 text-sm text-muted">CertUI keeps a tight scope on purpose:</p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-3">
            {
              scope.map((s) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <Icon name="heroicons:x-mark" width="16" height="16" class="mt-0.5 shrink-0 text-faint" aria-hidden="true" />
                  <span>{s}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
