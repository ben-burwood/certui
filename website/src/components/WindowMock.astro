---
// An interactive recreation of the CertUI dashboard, rendered from the app's
// identity. Endpoints are shown as an accordion: each row has a status badge and
// expands to reveal the TLS handshake, the full peer-certificate chain and WHOIS.
// Clicking a row opens it (one at a time, like the real app). Data is illustrative.

type CertStatus = 'ok' | 'expired';

interface PeerCert {
  status: CertStatus;
  countdown?: { days: number; hours: number; minutes: number };
  notBefore: string;
  notAfter: string;
  subject: string;
  issuer: string;
  sigAlg: string;
  pubKeyAlg: string;
}

interface Endpoint {
  url: string;
  address: string;
  resolves: boolean;
  badge: { type: 'success' | 'warning' | 'danger'; label: string };
  tls: { version: string; handshake: string; resume: string; cipher: string } | null;
  chain: PeerCert[];
  whois: { registrar: string; nameServers: string[]; expiration: string } | null;
}

const endpoints: Endpoint[] = [
  {
    url: 'https://www.google.com',
    address: '142.250.187.196',
    resolves: true,
    badge: { type: 'success', label: '62 Days Remaining' },
    tls: { version: '772', handshake: 'Yes', resume: 'No', cipher: '4865' },
    chain: [
      {
        status: 'ok',
        countdown: { days: 62, hours: 4, minutes: 51 },
        notBefore: '2025-08-11T08:22:14Z',
        notAfter: '2025-11-07T09:16:03Z',
        subject: 'CN=www.google.com',
        issuer: 'CN=WR2,O=Google Trust Services,C=US',
        sigAlg: 'SHA256-RSA',
        pubKeyAlg: 'ECDSA',
      },
      {
        status: 'ok',
        countdown: { days: 999, hours: 2, minutes: 8 },
        notBefore: '2023-12-13T09:00:00Z',
        notAfter: '2029-02-20T14:00:00Z',
        subject: 'CN=WR2,O=Google Trust Services,C=US',
        issuer: 'CN=GTS Root R1,O=Google Trust Services LLC,C=US',
        sigAlg: 'SHA256-RSA',
        pubKeyAlg: 'RSA',
      },
    ],
    whois: {
      registrar: 'MarkMonitor Inc.',
      nameServers: ['ns1.google.com', 'ns2.google.com', 'ns3.google.com', 'ns4.google.com'],
      expiration: '2028-09-14T04:00:00Z',
    },
  },
  {
    url: 'https://www.github.com',
    address: '140.82.121.3',
    resolves: true,
    badge: { type: 'success', label: '80 Days Remaining' },
    tls: { version: '772', handshake: 'Yes', resume: 'No', cipher: '4865' },
    chain: [
      {
        status: 'ok',
        countdown: { days: 80, hours: 11, minutes: 27 },
        notBefore: '2025-02-05T00:00:00Z',
        notAfter: '2025-11-25T23:59:59Z',
        subject: 'CN=github.com,O=GitHub\\, Inc.,L=San Francisco,ST=California,C=US',
        issuer: 'CN=Sectigo ECC Domain Validation Secure Server CA,O=Sectigo Limited,C=GB',
        sigAlg: 'SHA256-ECDSA',
        pubKeyAlg: 'ECDSA',
      },
    ],
    whois: {
      registrar: 'MarkMonitor Inc.',
      nameServers: ['dns1.p08.nsone.net', 'ns-1283.awsdns-32.org', 'ns-520.awsdns-01.net'],
      expiration: '2026-10-09T18:20:50Z',
    },
  },
  {
    url: 'https://shop.example.com',
    address: '203.0.113.24',
    resolves: true,
    badge: { type: 'warning', label: '12 Days Remaining' },
    tls: { version: '771', handshake: 'Yes', resume: 'Yes', cipher: '49199' },
    chain: [
      {
        status: 'ok',
        countdown: { days: 12, hours: 6, minutes: 3 },
        notBefore: '2025-06-19T00:00:00Z',
        notAfter: '2025-09-18T23:59:59Z',
        subject: 'CN=shop.example.com',
        issuer: "CN=R11,O=Let's Encrypt,C=US",
        sigAlg: 'SHA256-RSA',
        pubKeyAlg: 'RSA',
      },
    ],
    whois: {
      registrar: 'Namecheap, Inc.',
      nameServers: ['dns1.registrar-servers.com', 'dns2.registrar-servers.com'],
      expiration: '2026-03-01T00:00:00Z',
    },
  },
  {
    url: 'https://expired.badssl.com',
    address: '104.154.89.105',
    resolves: true,
    badge: { type: 'danger', label: 'Expired' },
    tls: { version: '771', handshake: 'Yes', resume: 'No', cipher: '49199' },
    chain: [
      {
        status: 'expired',
        notBefore: '2015-04-09T00:00:00Z',
        notAfter: '2015-04-12T23:59:59Z',
        subject: 'CN=*.badssl.com,OU=Domain Control Validated+OU=PositiveSSL Wildcard',
        issuer: 'CN=COMODO RSA Domain Validation Secure Server CA,O=COMODO CA Limited,L=Salford,ST=Greater Manchester,C=GB',
