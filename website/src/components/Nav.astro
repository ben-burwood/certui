---
import { Icon } from 'astro-icon/components';
import { REPO_URL } from '../consts';

const links = [
  { label: 'Features', href: '#features' },
  { label: 'Install', href: '#install' },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-surface/80 backdrop-blur supports-[backdrop-filter]:bg-surface/60"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <svg viewBox="0 0 64 64" class="h-7 w-7 text-accent" aria-hidden="true">
        <circle cx="32" cy="24" r="12" fill="none" stroke="currentColor" stroke-width="4"></circle>
        <path d="M26 36 L24 52 L32 46 L40 52 L38 36 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"></path>
        <path d="M26 24 L30 28 L38 20" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>CertUI</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-6">
      <div class="hidden items-center gap-6 text-sm text-muted sm:flex">
        {
          links.map((l) => (
            <a href={l.href} class="transition hover:text-ink">
              {l.label}
            </a>
          ))
        }
      </div>

      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3.5 py-2 text-sm font-medium text-ink transition hover:border-accent/50 hover:text-accent"
      >
        <Icon name="simple-icons:github" width="16" height="16" aria-hidden="true" />
        <span class="hidden xs:inline sm:inline">GitHub</span>
      </a>
    </div>
  </nav>
</header>
